# Environment
NODE_ENV=development

# Server Ports
PORT=3000
SIGNALING_PORT=4000

# Server Instance ID (for horizontal scaling - auto-generated if not set)
# In Kubernetes, you could use: SERVER_INSTANCE_ID=${POD_NAME}
# SERVER_INSTANCE_ID=

# Database
DATABASE_URL=postgresql://nothing:nothing@localhost:5432/connect_sdk

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Cluster (for high availability and horizontal scaling)
# Set REDIS_CLUSTER_ENABLED=true to use Redis Cluster mode
# REDIS_CLUSTER_ENABLED=false
# REDIS_CLUSTER_NODES=redis1:7000,redis2:7000,redis3:7000

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (HTTP API)
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=15 minutes

# Socket Rate Limiting
# Maximum number of socket connections per IP address within the connection window
SOCKET_RATE_LIMIT_MAX_CONNECTIONS=10
# Time window for connection rate limiting (e.g., "1 minute", "5 minutes", "1 hour")
SOCKET_RATE_LIMIT_CONNECTION_WINDOW=1 minute
# Maximum number of socket events per user/IP within the event window
SOCKET_RATE_LIMIT_MAX_EVENTS=100
# Time window for event rate limiting (e.g., "15 minutes", "1 hour")
SOCKET_RATE_LIMIT_EVENT_WINDOW=15 minutes

# Mediasoup
# For local development: Leave empty or set to 'auto' to auto-detect IP
# For production: Set to your public IP address or domain name (e.g., '203.0.113.1' or 'mediasoup.example.com')
# For Docker/VMs: Set to the host's public IP address
# IMPORTANT: If connecting from remote clients, this MUST be set to the public IP
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=2000
MEDIASOUP_RTC_MAX_PORT=2420

# Optional: STUN/TURN servers (if using external TURN server for NAT traversal)
# Format: "stun:stun.example.com:3478" or "turn:turn.example.com:3478?transport=udp"
# MEDIASOUP_STUN_SERVERS=
# MEDIASOUP_TURN_SERVERS=

# Recording & Storage
RECORDING_ENABLED=false
RECORDING_TMP_DIR=./tmp/recordings
RECORDING_FFMPEG_PATH=ffmpeg
RECORDING_LAYOUT=pip
RECORDING_BIND_IP=127.0.0.1
RECORDING_PORT_MIN=60000
RECORDING_PORT_MAX=60200

# AWS (Recording Upload)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RECORDING_S3_BUCKET=
RECORDING_S3_PREFIX=recordings/
RECORDING_S3_SSE=aws:kms

# AWS (Avatar Storage)
AVATAR_S3_BUCKET=
AVATAR_S3_PREFIX=avatars/
# SSE for avatars: leave empty for no encryption, or use "AES256" for encryption
# Note: Do NOT use "aws:kms" for avatars as it requires authenticated requests
# even for public objects, which breaks direct browser access
AVATAR_S3_SSE=

